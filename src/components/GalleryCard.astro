---
import BeforeAfterSlider from "./BeforeAfterSlider.astro";

interface Props {
  category: string;
  title: string;
  date: string;
  beforeSrc: string;
  afterSrc: string;
  href?: string;
}

const { category, title, date, beforeSrc, afterSrc, href } = Astro.props;
const Footer = href ? "a" : "div";
---

<div class="bg-white border border-steel-200">
  <BeforeAfterSlider
    beforeSrc={beforeSrc}
    beforeAlt={`${title} — before`}
    afterSrc={afterSrc}
    afterAlt={`${title} — after`}
  />
  <Footer href={href} class={`block p-4 ${href ? "hover:bg-steel-50 transition" : ""}`}>
    <p class="text-[10px] font-bold uppercase tracking-widest text-brand-red mb-1">{category}</p>
    <p class="font-heading font-bold text-brand-black">{title}</p>
    <p class="text-xs text-steel-600">{date}</p>
  </Footer>
</div>
