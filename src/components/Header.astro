---
import { routes, asset } from "../lib/site";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const navItems = [
  { key: "house-leveling", label: "House Leveling", href: routes.houseLeveling },
  { key: "house-lifting", label: "House Lifting", href: routes.houseLifting },
  { key: "foundation-repair", label: "Foundation Repair", href: routes.foundationRepair },
  { key: "gallery", label: "Gallery", href: routes.gallery },
  { key: "about", label: "About", href: routes.about },
  { key: "contact", label: "Contact", href: routes.contact },
];

const phone = "(337) 309-7301";
const phoneHref = "tel:+13373097301";
---

<header class="bg-white border-b-2 border-brand-black relative z-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href={routes.home} class="flex flex-col items-center shrink-0">
      <img src={asset("assets/derived/logo-roofline.png")} alt="" class="w-32 sm:w-44 h-auto mb-1" />
      <span class="leading-tight text-center">
        <span class="block font-heading font-bold text-2xl sm:text-3xl text-brand-black">
          ONE <span class="text-brand-red">STOP</span>
        </span>
        <span class="block text-xs sm:text-sm uppercase tracking-widest text-steel-500">
          Construction &amp; Leveling
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold uppercase tracking-wide text-steel-700">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={item.key === currentPage ? "text-brand-red" : "hover:text-brand-red"}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile: call icon + hamburger -->
    <div class="flex lg:hidden items-center gap-2">
      <a
        href={phoneHref}
        aria-label={`Call ${phone}`}
        class="inline-flex items-center justify-center h-9 w-9 bg-brand-red text-white rounded-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1.1l-2.3 2.1z"></path>
        </svg>
      </a>
      <button
        id="navToggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="navDropdown"
        class="inline-flex items-center justify-center h-9 w-9 border border-brand-black"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Floating mobile dropdown -->
  <div class="nav-dropdown border-t border-steel-200" id="navDropdown">
    <nav class="flex flex-col px-4 text-steel-700 text-sm font-semibold uppercase tracking-wide">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class={i < navItems.length - 1 ? "py-3 border-b border-steel-50" : "py-3"}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="px-4 pb-4 pt-1">
      <a href={phoneHref} class="block text-center bg-brand-red text-white font-bold py-3 rounded-sm">
        {phone}
      </a>
    </div>
  </div>
</header>
<div class="nav-backdrop" id="navBackdrop"></div>

<style>
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
    z-index: 40;
  }
  .nav-dropdown.open {
    max-height: 500px;
  }
  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 30;
  }
  .nav-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const navToggle = document.getElementById("navToggle");
  const navDropdown = document.getElementById("navDropdown");
  const navBackdrop = document.getElementById("navBackdrop");

  function closeNav() {
    navDropdown?.classList.remove("open");
    navBackdrop?.classList.remove("open");
    navToggle?.setAttribute("aria-expanded", "false");
  }

  function toggleNav() {
    const isOpen = navDropdown?.classList.toggle("open");
    navBackdrop?.classList.toggle("open", isOpen);
    navToggle?.setAttribute("aria-expanded", String(Boolean(isOpen)));
  }

  navToggle?.addEventListener("click", toggleNav);
  navBackdrop?.addEventListener("click", closeNav);
</script>
