---
import Layout from "../layouts/Layout.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import TrustBadgesCompact from "../components/TrustBadgesCompact.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { routes, asset } from "../lib/site";

const steps = [
  { title: "Free Inspection", description: "We assess the foundation and identify the cause of settling." },
  { title: "Plan & Estimate", description: "You get a clear, no-obligation plan before any work starts." },
  { title: "Gentle Lifting", description: "Air bag lifting raises the structure slowly and evenly." },
  { title: "Final Check", description: "We verify the level and back the work with a warranty." },
];

const badges = [
  { title: "Free Estimates", description: "No obligation" },
  { title: "Air Bag Lifting", description: "Gentle and controlled" },
  { title: "Warranty", description: "On all work" },
];
---

<Layout title="House Leveling in Lake Charles, LA" currentPage="house-leveling">
  <section class="bg-brand-black text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-4">House Leveling in Lake Charles, LA</h1>
      <p class="text-steel-200 max-w-2xl mx-auto mb-7">
        When a house settles unevenly, floors slope, doors stick, and cracks start to appear. We correct the settling
        at its source — not just patch the symptoms — using gentle, controlled lifting.
      </p>
      <a href={routes.contact} class="inline-flex items-center gap-2 bg-brand-red text-white font-bold px-6 py-3 rounded-sm hover:bg-brand-red-hover transition">
        Get a Free Estimate
      </a>
    </div>
  </section>

  <ProcessSteps steps={steps} />

  <!-- Placeholder: reuses the one approved before/after pair (Tan House Full Leveling) until each service page has its own cleared photos -->
  <section class="bg-brand-black text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h2 class="font-heading text-2xl font-bold mb-6">A Recent House Leveling Project</h2>
      <BeforeAfterSlider
        beforeSrc={asset("assets/derived/before-after/02-tan-house-leveling-before.jpg")}
        beforeAlt="Before: house settled low to the ground"
        afterSrc={asset("assets/derived/before-after/02-tan-house-leveling-after.jpg")}
        afterAlt="After: house raised and leveled on new piers"
        class="mx-auto"
      />
    </div>
  </section>

  <TrustBadgesCompact badges={badges} />
  <CtaBanner heading="Ready for a free inspection?" />
</Layout>
