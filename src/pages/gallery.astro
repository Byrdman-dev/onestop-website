---
import Layout from "../layouts/Layout.astro";
import GalleryCard from "../components/GalleryCard.astro";
import { asset } from "../lib/site";

const projects = [
  {
    category: "House Leveling",
    title: "Tan House Full Leveling",
    date: "Feb–Apr 2025",
    beforeSrc: asset("assets/derived/before-after/02-tan-house-leveling-before.jpg"),
    afterSrc: asset("assets/derived/before-after/02-tan-house-leveling-after.jpg"),
  },
  {
    category: "Foundation Repair",
    title: "Blue House Siding & Sill Rebuild",
    date: "Feb 2026",
    beforeSrc: asset("assets/derived/before-after/01-blue-house-siding-before.jpg"),
    afterSrc: asset("assets/derived/before-after/01-blue-house-siding-after.jpg"),
  },
  {
    category: "House Lifting",
    title: "Cabin Lifted Onto Trailer for Move",
    date: "Jun 2023",
    beforeSrc: asset("assets/derived/before-after/11-cabin-trailer-move-before.jpg"),
    afterSrc: asset("assets/derived/before-after/11-cabin-trailer-move-after.jpg"),
  },
  {
    category: "Additional Work",
    title: "Mobile Home Deck, Ramp & Porch Roof",
    date: "Oct 2025",
    beforeSrc: asset("assets/derived/before-after/06-mobile-home-deck-ramp-porch-before.jpg"),
    afterSrc: asset("assets/derived/before-after/06-mobile-home-deck-ramp-porch-after.jpg"),
  },
  {
    category: "Additional Work",
    title: "Porch & Ramp Build",
    date: "Feb 2025",
    beforeSrc: asset("assets/derived/before-after/14-porch-ramp-build-before.jpg"),
    afterSrc: asset("assets/derived/before-after/14-porch-ramp-build-after.jpg"),
  },
];
---

<Layout title="Gallery" currentPage="gallery">
  <section class="bg-brand-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 text-center">
      <h1 class="font-heading text-2xl sm:text-3xl font-bold mb-2">Our Work</h1>
      <p class="text-steel-200 text-sm max-w-xl mx-auto">Real before/after results from projects around Lake Charles.</p>
    </div>
  </section>

  <section class="bg-steel-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {projects.map((project) => (
        <GalleryCard {...project} />
      ))}
    </div>
  </section>
</Layout>
