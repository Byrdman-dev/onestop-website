---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us" currentPage="contact">
  <!--
    This page's main content is the shared contact block that also appears
    in every page's footer — see Footer.astro.
  -->
  <section class="bg-brand-black text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 text-center">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-steel-200 max-w-xl mx-auto">
        Call, visit, or send a message below — we're here to help, Mon–Sat 7am–7pm.
      </p>
    </div>
  </section>
</Layout>
